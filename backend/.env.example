# Copy this file to .env and fill in values. NEVER commit .env.
HOST=127.0.0.1
PORT=3000
RATE_LIMIT_PER_MIN=60

# Your PC's Tailscale HTTPS address (shown by `tailscale serve status`)
PUBLIC_URL=https://your-pc.tailXXXX.ts.net

# Create in Google AI Studio yourself and paste here only. Never share it.
GEMINI_API_KEY=

# Free-tier model IDs (optional; defaults shown). Check ai.google.dev/gemini-api/docs/pricing if one stops working.
GEMINI_MODEL_SMALL=gemini-3.5-flash-lite
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_TTS=gemini-3.8-flash-lite-tts
# Voice for spoken replies (Gemini prebuilt voice name)
GEMINI_TTS_VOICE=Charon
